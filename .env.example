# ---------- apps/api ----------
DATABASE_URL=postgresql://tp:tp@localhost:5432/tonights_pick
PORT=8080

# Qloo: event key from the form in Qloo's developer guide. Used ONLY by the qloo harness process.
QLOO_API_KEY=
# The hackathon key only works on the hackathon server (this is the default).
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Every model call goes to NVIDIA Nemotron on Nebius Token Factory.
LLM_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Exact IDs from GET /v1/models on Token Factory (also shown on /health). Checked 2026-10-15.
LLM_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_CLASSIFIER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional fallback provider (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

CLASSIFIER=llm            # llm | roberta
CLASSIFY_MAX_PER_TITLE=600

TMDB_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_UNIT_RESERVE=4000
YOUTUBE_DAILY_UNITS=10000
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=     # app password from YOUR account; read-only search only
REDDIT_CLIENT_ID=         # blank = Reddit switched off
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
TRAKT_CLIENT_ID=          # blank = Trakt switched off

MCP_BEARER_TOKEN=
AUTHOR_HASH_SALT=
API_SHARED_SECRET=
STREAM_TOKEN_SECRET=
WEB_ORIGIN=http://localhost:3000
ADMIN_SECRET=

CAP_LLM_PRESCORE_USD=10
CAP_LLM_DAILY_USD=1
CAP_QLOO_DAILY_CALLS=3000
PICK_WEIGHT_TASTE=0.5
PICK_WEIGHT_RECEPTION=0.5

# ---------- apps/web ----------
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_STREAM_URL=http://localhost:8080
# API_SHARED_SECRET and STREAM_TOKEN_SECRET must match the api values above.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
