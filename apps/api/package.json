{
  "name": "@tp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "qloo:schemas": "tsx --env-file-if-exists=../../.env scripts/qloo-schemas.ts",
    "qloo:smoke": "tsx --env-file-if-exists=../../.env scripts/qloo-smoke.ts",
    "llm:models": "tsx --env-file-if-exists=../../.env scripts/llm-models.ts",
    "llm:smoke": "tsx --env-file-if-exists=../../.env scripts/llm-smoke.ts",
    "prescore": "tsx --env-file-if-exists=../../.env scripts/prescore.ts",
    "eval": "tsx --env-file-if-exists=../../.env scripts/eval.ts",
    "agent:try": "tsx --env-file-if-exists=../../.env scripts/agent-try.ts"
  },
  "dependencies": {
    "@atproto/api": "0.27.0",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@prisma/client": "6.19.3",
    "@qloo/qloo-harness": "0.1.26",
    "@tp/scoring": "workspace:*",
    "@tp/shared": "workspace:*",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "openai": "5.23.2",
    "pg-boss": "10.4.2",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
